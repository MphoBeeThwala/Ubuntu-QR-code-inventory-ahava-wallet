{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npx turbo run build --filter=@ahava/pwa..."
  },
  "deploy": {
    "startCommand": "npm run start --workspace @ahava/pwa",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "watchPatterns": [
    "/package.json",
    "/package-lock.json",
    "/turbo.json",
    "/apps/pwa/**"
  ]
}
