{
  "name": "@ahava/auth-service",
  "version": "1.0.0",
  "private": true,
  "description": "Auth Service - User authentication & device management",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node --env-file=../../.env --require ts-node/register src/main.ts",
