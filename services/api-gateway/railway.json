{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npx turbo run build --filter=@ahava/api-gateway..."
  },
  "deploy": {
    "startCommand": "npm run start --workspace @ahava/api-gateway",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "watchPatterns": [
    "/package.json",
    "/package-lock.json",
    "/turbo.json",
    "/packages/shared-crypto/**",
    "/packages/shared-errors/**",
    "/packages/shared-events/**",
    "/services/api-gateway/**"
  ]
}
