{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run prisma:generate && npx turbo run build --filter=@ahava/kyc-service..."
  },
  "deploy": {
    "startCommand": "npm run start --workspace @ahava/kyc-service",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "watchPatterns": [
    "/package.json",
    "/package-lock.json",
    "/turbo.json",
    "/prisma/**",
    "/packages/shared-audit/**",
    "/packages/shared-errors/**",
    "/packages/shared-events/**",
    "/services/kyc-service/**"
  ]
}
