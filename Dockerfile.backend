FROM node:20-alpine AS base

# Set working directory
WORKDIR /app

# Install dependencies needed for turbo and prisma
RUN apk add --no-cache libc6-compat openssl
RUN npm install -g turbo

# ---------------------------------------------------------
# Builder stage
# ---------------------------------------------------------
FROM base AS builder
# Take a build argument to know which app to build
ARG APP_NAME

COPY . .
# Run turbo prune to extract just the files needed for the target app
RUN turbo prune --scope=${APP_NAME} --docker

# ---------------------------------------------------------
# Installer stage
# ---------------------------------------------------------
FROM base AS installer
ARG APP_NAME

# First install dependencies (as they change less often)
COPY --from=builder /app/out/json/ .
COPY --from=builder /app/out/package-lock.json ./package-lock.json
RUN npm install

# Build the project
COPY --from=builder /app/out/full/ .
# Generate prisma client if needed
RUN if [ -f "packages/database/prisma/schema.prisma" ]; then npx prisma generate --schema=packages/database/prisma/schema.prisma; fi

# Run the build for the specific app
RUN turbo run build --filter=${APP_NAME}

# ---------------------------------------------------------
# Runner stage
# ---------------------------------------------------------
FROM base AS runner
ARG APP_NAME
ARG PORT=6000

ENV NODE_ENV=production
ENV PORT=${PORT}

# Don't run production as root
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 expressjs
USER expressjs

# Copy built application and dependencies
COPY --from=installer --chown=expressjs:nodejs /app .

# Expose port
EXPOSE ${PORT}

# Start the application using the package.json start script
CMD npm run start --workspace=${APP_NAME}
