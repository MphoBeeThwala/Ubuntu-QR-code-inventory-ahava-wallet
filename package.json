{
  "name": "ubuntu-pay-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Ubuntu Pay / Ahava Wallet - Complete Digital Payment Platform",
  "author": "Mpho Thwala, CEO of Ahava on 88 Pty Ltd",
  "license": "Proprietary",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "bootstrap": "npm install",
    "build": "turbo run build --parallel",
    "build:all": "npm run build",
    "build:services": "turbo run build --filter=./services/* --parallel",
    "build:apps": "turbo run build --filter=./apps/* --parallel",
    "build:packages": "turbo run build --filter=./packages/* --parallel",
    "dev": "concurrently \"npm run dev:services\" \"npm run dev:apps\"",
    "dev:services": "turbo run dev --filter=./services/* --parallel",
    "dev:apps": "turbo run dev --filter=./apps/* --parallel",
    "start": "npm run start:gateway",
    "start:all": "concurrently \"npm run start:services\" \"npm run start:apps\"",
    "start:gateway": "cd services/api-gateway && npm run start",
    "start:services": "turbo run start --filter=./services/* --parallel",
    "start:apps": "turbo run start --filter=./apps/* --parallel",
    "lint": "turbo run lint --parallel",
    "test": "turbo run test --parallel",
    "clean": "turbo run clean --parallel && rm -rf node_modules",
    "docker:build": "docker-compose -f docker-compose.yml build",
    "docker:up": "docker-compose -f docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker-compose.yml down",
    "migrate": "npx prisma migrate deploy",
    "migrate:dev": "npx prisma migrate dev",
    "generate": "npx prisma generate",
    "seed": "npx prisma db seed",
    "prisma:studio": "npx prisma studio"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "packageManager": "npm@8.19.4"
}