{
  "name": "ubuntu-pay-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Ubuntu Pay / Ahava Wallet - Complete Digital Payment Platform",
  "author": "Mpho Thwala, CEO of Ahava on 88 Pty Ltd",
  "license": "Proprietary",
  "scripts": {
    "install:all": "pnpm install --recursive",
    "bootstrap": "pnpm install --recursive",
    "build": "pnpm --filter \"!./apps/*\" run build",
    "build:all": "pnpm run build",
    "build:services": "pnpm --filter ./services/* run build",
    "build:apps": "pnpm --filter ./apps/* run build",
    "build:packages": "pnpm --filter ./packages/* run build",
    "dev": "concurrently \"pnpm --filter ./services/* run dev\" \"pnpm --filter ./apps/* run dev\"",
    "dev:services": "pnpm --filter ./services/* run dev",
    "dev:apps": "pnpm --filter ./apps/* run dev",
    "start": "pnpm --filter ahava-api-gateway run start",
    "start:all": "concurrently \"pnpm --filter ./services/* run start\" \"pnpm --filter ./apps/* run start\"",
    "start:gateway": "pnpm --filter ahava-api-gateway run start",
    "start:services": "pnpm --filter ./services/* run start",
    "start:apps": "pnpm --filter ./apps/* run start",
    "lint": "pnpm --filter ./services/* run lint",
    "test": "pnpm --filter ./services/* run test",
    "clean": "pnpm --filter ./services/* run clean && rm -rf node_modules",
    "docker:build": "docker-compose -f docker-compose.yml build",
    "docker:up": "docker-compose -f docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker-compose.yml down",
    "migrate": "pnpm --filter ./services/* exec npx prisma migrate deploy",
    "migrate:dev": "pnpm --filter ./services/* exec npx prisma migrate dev",
    "generate": "pnpm --filter ./services/* exec npx prisma generate",
    "seed": "pnpm --filter ./services/* exec npx prisma db seed",
    "prisma:studio": "pnpm --filter ./services/* exec npx prisma studio"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}