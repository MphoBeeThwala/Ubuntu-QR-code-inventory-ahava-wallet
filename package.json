{
  "name": "ahava-ewallet",
  "version": "1.0.0",
  "private": true,
  "description": "Ahava eWallet — inclusive South African digital wallet platform",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "start": "echo 'Ahava eWallet — use Railway service routing to access individual services'",
    "prepare": "husky install",
    "dev": "npm run dev:docker && npm run dev:services",
    "dev:docker": "docker-compose up -d postgres redis",
    "dev:services": "turbo run dev --concurrency=15",
    "dev:kill-ports": "npx kill-port 3010 3020 6000 6001 6002 6003 6004 6005 6006 6007 6008 6009",
    "dev:clean": "npm run dev:kill-ports && npm run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "npx prisma migrate dev --schema=prisma/schema.prisma",
    "db:migrate:prod": "npx prisma migrate deploy --schema=prisma/schema.prisma",
    "db:seed": "npx ts-node packages/database/src/seed.ts",
    "db:studio": "npx prisma studio --schema=prisma/schema.prisma",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:reset": "docker-compose down -v && docker-compose up -d",
    "integration:up": "node scripts/integration-up.js",
    "integration:smoke": "node scripts/integration-smoke.js",
    "integration:down": "node scripts/integration-down.js",
    "smoke:payment": "node scripts/smoke-payment.js",
    "secrets:validate": "node scripts/validate-secrets.js",
    "audit:deps": "npm audit --audit-level=high",
    "test:check-coverage": "node scripts/check-coverage.js",
    "test:all": "turbo run test:coverage && node scripts/check-coverage.js"
  },
  "devDependencies": {
    "@prisma/client": "^5.8.0",
    "@types/jest": "^29.5.10",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.2.0",
    "prisma": "^5.8.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "turbo": "^1.13.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "axios": "^1.13.6",
    "dotenv": "^17.3.1",
    "winston": "^3.19.0"
  }
}
