{
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "npm start"
  },
  "services": [
    {
      "name": "pwa",
      "source": {
        "root": "apps/pwa"
      },
      "build": {
        "builder": "NIXPACKS"
      },
      "deploy": {
        "startCommand": "npm start"
      },
      "healthcheckPath": "/"
    },
    {
      "name": "api-gateway",
      "source": {
        "root": "services/api-gateway"
      },
      "build": {
        "builder": "NIXPACKS",
        "buildCommand": "npm run build"
      },
      "deploy": {
        "startCommand": "npm start"
      },
      "healthcheckPath": "/health"
    },
    {
      "name": "auth-service",
      "source": {
        "root": "services/auth-service"
      },
      "build": {
        "builder": "NIXPACKS",
        "buildCommand": "npx prisma generate && npm run build"
      },
      "deploy": {
        "startCommand": "npm start"
      },
      "healthcheckPath": "/health"
    },
    {
