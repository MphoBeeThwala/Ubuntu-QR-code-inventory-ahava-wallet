{
  "name": "ubuntu-pay-api-docs",
  "version": "1.0.0",
  "description": "Ubuntu Pay Platform API Documentation",
  "scripts": {
    "serve": "npx @redocly/cli preview-docs docs/api/openapi.yaml --port 8082",
