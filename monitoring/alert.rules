groups:
- name: service-health
  rules:
  - alert: ServiceDown
    expr: up == 0
    for: 1m
    labels:
      severity: critical
    annotations:
      summary: Service down
      description: Service has been down for more than 1 minute

  - alert: HighErrorRate
    expr: rate(http_requests_total{status=~"5.."}[1m]) / rate(http_requests_total[1m]) > 0.1
    for: 5m
    labels:
      severity: critical
    annotations:
      summary: High error rate
      description: Error rate exceeds 10 percent

  - alert: HighLatency
    expr: histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le)) > 2
    for: 5m
    labels:
      severity: warning
    annotations:
      summary: High latency
      description: 95th percentile latency exceeds 2 seconds

- name: financial
  rules:
  - alert: FailedTransactions
    expr: rate(transaction_failures_total[5m]) > 0
    for: 1m
    labels:
      severity: critical
    annotations:
      summary: Failed transactions detected
      description: Transaction failures detected

  - alert: LedgerImbalance
    expr: abs(sum(ledger_debit_amount_cents) - sum(ledger_credit_amount_cents)) > 0
    for: 1m
    labels:
      severity: critical
    annotations:
      summary: Ledger imbalance
      description: Debits and credits do not balance

- name: database
  rules:
  - alert: DatabaseDown
    expr: up{job="postgresql"} == 0
    for: 1m
    labels:
      severity: critical
    annotations:
      summary: PostgreSQL down
      description: PostgreSQL has been down for more than 1 minute

  - alert: RedisDown
    expr: up{job="redis"} == 0
    for: 1m
    labels:
      severity: critical
    annotations:
      summary: Redis down
      description: Redis has been down for more than 1 minute