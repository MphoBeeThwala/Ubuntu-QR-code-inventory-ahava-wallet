# Ubuntu Pay / Ahava Wallet - Environment Variables
# Developed by: Mpho Thwala, CEO of Ahava on 88 Pty Ltd
# Date: July 2026
# Copy this file to .env and fill in your values
# NEVER commit .env to Git!

# REQUIRED FOR ALL SERVICES
NODE_ENV=development
DATABASE_URL=postgresql://ahava:your_password@localhost:5432/ahava_dev
REDIS_URL=redis://localhost:6379

# JWT CONFIGURATION (Required for auth-service, and every service that
# verifies tokens via requireAuth)
# Generate keys with: ./scripts/generate-jwt-keys.sh
# Paste the FULL contents of each .pem file here, including the
# -----BEGIN...----- / -----END...----- header/footer lines and the
# real line breaks in between. jsonwebtoken's RS256 sign/verify calls
# (packages/shared-crypto/src/index.ts) pass this value straight into
# Node's crypto module, which requires a complete, correctly-formatted
# PEM — stripping the header/footer lines makes every login fail.
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nyour_key_content\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nyour_key_content\n-----END PUBLIC KEY-----

# AFRICA'S TALKING (Optional - for SMS)
# Get from: https://account.africastalking.com
# Leave empty to use stub mode (console logging)
AT_USERNAME=your_at_username
AT_API_KEY=your_at_api_key

# USSD CALLBACK AUTHENTICATION (Required for ussd-service)
# ussd-service has its own public ingress, bypassing api-gateway's JWT
# middleware entirely — a real USSD callback has no way to carry a Bearer
# token. This secret must be embedded in the callback URL configured in
# the Africa's Talking dashboard instead: set the USSD shortcode's
# callback URL to https://<your-ussd-host>/ussd?token=<this value>.
# Without it set, ussd-service rejects every USSD callback (fails closed).
# Generate with: openssl rand -hex 32
USSD_CALLBACK_TOKEN=generate_a_random_secret_do_not_use_this_placeholder

# FIREBASE (Optional - for Push Notifications)
# Get from Firebase Console > Project Settings > Service Accounts
# FREE tier available for development
FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "your-project-id"}

# COMPLYADVANTAGE (Optional - for AML Screening)
# Get from: https://complyadvantage.com
# Leave empty to use stub mode (always returns CLEAR)
COMPLYADVANTAGE_API_KEY=your_api_key

# SANCTIONS SCREENING (Required for payment-service)
# payment-service calls aml-service synchronously before every payment
# commits. Fails CLOSED (blocks the payment) if aml-service is unreachable.
# Set SANCTIONS_SCREENING_ENABLED=false only for local dev without
# aml-service running — never in staging/production.
AML_SERVICE_URL=http://localhost:6007
SANCTIONS_SCREENING_ENABLED=true

# MLRO ALERTS (Required for aml-service)
# aml-service's MlroNotifier sends CRITICAL/HIGH AML flag alerts to this
# address via notification-service. Without it set, alerts are queued but
# fail to dispatch (logged, retried, then marked FAILED) — the compliance
# team silently never hears about the flag.
MLRO_ALERT_EMAIL=compliance@ahava.example

# KYC DOCUMENT UPLOADS (Required for kyc-service)
# kyc-service issues short-lived presigned S3 PUT URLs (POST
# /kyc/document/upload-url) so the client uploads identity documents
# directly to S3, never through api-gateway's JSON-only proxying. Without
# this set, upload-url requests fail with a clear 503 rather than silently
# generating a URL against a bucket that doesn't exist.
KYC_DOCUMENTS_BUCKET=ahava-kyc-documents-dev
AWS_REGION=af-south-1

# SERVICE-SPECIFIC CONFIGURATION
PORT=3000
SERVICE_NAME=your-service-name

# RENDER.COM SPECIFIC
# When deployed on Render, DATABASE_URL and REDIS_URL are auto-injected
