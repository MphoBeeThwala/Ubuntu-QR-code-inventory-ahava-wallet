# Ubuntu Pay / Ahava Wallet - Environment Variables
# Developed by: Mpho Thwala, CEO of Ahava on 88 Pty Ltd
# Date: July 2026
# Copy this file to .env and fill in your values
# NEVER commit .env to Git!

# REQUIRED FOR ALL SERVICES
NODE_ENV=development
DATABASE_URL=postgresql://ahava:your_password@localhost:5432/ahava_dev
REDIS_URL=redis://localhost:6379

# JWT CONFIGURATION (Required for auth-service)
# Generate keys with: ./scripts/generate-jwt-keys.sh
# Then copy the contents (without BEGIN/END lines) here
JWT_PRIVATE_KEY=your_rsa_private_key_here_without_begin_end_lines
JWT_PUBLIC_KEY=your_rsa_public_key_here_without_begin_end_lines

# AFRICA'S TALKING (Optional - for SMS)
# Get from: https://account.africastalking.com
# Leave empty to use stub mode (console logging)
AT_USERNAME=your_at_username
AT_API_KEY=your_at_api_key

# FIREBASE (Optional - for Push Notifications)
# Get from Firebase Console > Project Settings > Service Accounts
# FREE tier available for development
FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "your-project-id"}

# COMPLYADVANTAGE (Optional - for AML Screening)
# Get from: https://complyadvantage.com
# Leave empty to use stub mode (always returns CLEAR)
COMPLYADVANTAGE_API_KEY=your_api_key

# SERVICE-SPECIFIC CONFIGURATION
PORT=3000
SERVICE_NAME=your-service-name

# RENDER.COM SPECIFIC
# When deployed on Render, DATABASE_URL and REDIS_URL are auto-injected
