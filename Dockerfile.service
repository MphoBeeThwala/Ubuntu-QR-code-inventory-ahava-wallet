# Ahava eWallet — Unified Backend Service Dockerfile
# Usage: docker build -f Dockerfile.service --build-arg SERVICE_NAME=auth-service -t auth-service .
#
# This is a pnpm workspace monorepo (pnpm-workspace.yaml + the
# "packageManager" field in root package.json). Several services'
# package.json files use the pnpm-only "workspace:" version protocol,
# and none of these @ahava/* internal packages exist on the public npm
# registry — plain "npm ci" fails here (EUNSUPPORTEDPROTOCOL, or a 404
# trying to fetch "@ahava/shared-errors" from npm). Must use pnpm.

ARG SERVICE_NAME=auth-service

# ─── Stage 1: Builder ────────────────────────────────────────────
FROM node:20-slim AS builder
ARG SERVICE_NAME

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && corepack prepare pnpm@8.15.9 --activate

# Full workspace manifest + source. pnpm needs every workspace member's
# package.json visible (pnpm-workspace.yaml globs packages/*,
# services/*, apps/*) to resolve internal @ahava/* dependencies
# correctly, even though only one service actually gets built below.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY prisma/ prisma/
COPY packages/ packages/
COPY services/ services/
COPY apps/pwa/package.json apps/pwa/
COPY apps/agent-portal/package.json apps/agent-portal/

# pnpm-lock.yaml can drift from package.json between deploys (it isn't
# regenerated automatically here on every dependency change) —
# --no-frozen-lockfile lets pnpm resolve against the real package.json
# files instead of hard-failing on a stale lockfile.
RUN pnpm install --no-frozen-lockfile

RUN npx prisma generate

# Builds the target service and every @ahava/* package it depends on —
# the "..." suffix pulls in workspace dependencies, in build order.
# NOTE: ussd-service's real package name is @ahava/ussd-gateway, not
# @ahava/ussd-service — if deploying it via this file, pass
# --build-arg SERVICE_NAME=ussd-service (the directory name; the CMD
# path below is directory-based) but be aware the pnpm --filter target
# differs, which is why services/ussd-service/Dockerfile (built
# directly, not via this file) is the safer path for that one service.
RUN pnpm --filter "@ahava/${SERVICE_NAME}..." run build

# ─── Stage 2: Runner ─────────────────────────────────────────────
FROM node:20-slim AS runner
ARG SERVICE_NAME

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1001 ahava && useradd --uid 1001 --gid ahava --create-home ahava

# pnpm gives each workspace package its own node_modules with symlinks
# scoped to that package's own declared dependencies (unlike npm
# workspaces' root-hoisted layout) — copying only dist/ + package.json
# leaves that directory behind, so a top-level `require("express")` (or
# any other direct dependency) has nothing to resolve at runtime. Copy
# the whole services/${SERVICE_NAME}/ directory instead.
COPY --from=builder --chown=ahava:ahava /app/node_modules            ./node_modules
COPY --from=builder --chown=ahava:ahava /app/packages                ./packages
COPY --from=builder --chown=ahava:ahava /app/services/${SERVICE_NAME} ./services/${SERVICE_NAME}

USER ahava

# Docker's exec-form CMD (the ["node", ...] array form) does NOT perform
# variable substitution — only the shell form does, and only for
# variables that exist in the container's actual runtime environment,
# which means baking SERVICE_NAME as ENV (not just ARG, which is
# build-time only) here.
ENV SERVICE_NAME=${SERVICE_NAME}
ENV PORT=3000
EXPOSE ${PORT}

CMD node services/$SERVICE_NAME/dist/main.js
