#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Run lint-staged to format/validate staged files
npx lint-staged

# Run gitleaks secret scan only if the binary is installed locally.
# The full scan runs in CI (GitHub Actions) regardless.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks detect --staged --exit-code 1
else
  echo "ℹ️  gitleaks not installed locally — skipping local secret scan (CI enforces this)"
fi
