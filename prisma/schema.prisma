// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// BATCH 1: Ledger Foundation
// ============================================

enum EntryType {
  DEBIT
  CREDIT
}

model LedgerEntry {
  id                     String    @id @default(cuid())
  transactionId          String
  walletId               String
  userId                 String
  entryType              EntryType
  accountCode            String
  amountCents            BigInt
  currency               String    @default("ZAR")
  description            String?
  reference              String?
  counterpartyWalletId   String?
  counterpartyAccountCode String?
  metadata               Json?
  createdAt              DateTime  @default(now())

  @@id([transactionId, entryType, walletId])
  @@index([walletId])
  @@index([transactionId])
  @@index([createdAt])
  @@index([entryType])
}

// ============================================
// BATCH 3: QR Payment Idempotency
// ============================================

enum QrPaymentStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

model QrPayment {
  id            String    @id @default(cuid())
  qrCodeId      String    @unique
  transactionId String    @unique
  walletId      String
  amountCents  BigInt
  currency     String    @default("ZAR")
  status        QrPaymentStatus @default(PENDING)
  reference     String?
  metadata      Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  expiresAt    DateTime
  
  @@index([qrCodeId])
  @@index([transactionId])
  @@index([walletId])
  @@index([status])
  @@index([expiresAt])
}

// ============================================
// BATCH 4: Fee Accounting Consistency
// ============================================

enum FeeType {
  TRANSACTION_FEE
  WITHDRAWAL_FEE
  DEPOSIT_FEE
  SETTLEMENT_FEE
  PLATFORM_FEE
  AGENT_COMMISSION
  SERVICE_FEE
  FX_FEE
}

enum FeeStatus {
  PENDING
  COMPLETED
  REVERSED
  REFUNDED
}

model Fee {
  id            String    @id @default(cuid())
  transactionId String
  walletId      String
  userId        String?
  feeType       FeeType
  amountCents  BigInt
  currency     String    @default("ZAR")
  status        FeeStatus @default(PENDING)
  description   String?
  reference     String?
  debitEntryId  String?
  creditEntryId String?
  metadata      Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  settledAt    DateTime?
  
  @@index([transactionId])
  @@index([walletId])
  @@index([feeType])
  @@index([status])
  @@index([createdAt])
  
  debitEntry  LedgerEntry?  @relation(fields: [debitEntryId], references: [id])
  creditEntry LedgerEntry? @relation(fields: [creditEntryId], references: [id])
}

model FeeConfiguration {
  id          String   @id @default(cuid())
  feeType     FeeType  @unique
  calculationMethod String
  baseValue   BigInt
  minFeeCents BigInt   @default(0)
  maxFeeCents BigInt?
  tiers       Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([feeType])
  @@index([isActive])
}

// ============================================
// BATCH 5: Saga Reversal
// ============================================

enum SagaStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  REVERSING
  REVERSED
  PARTIALLY_REVERSED
}

enum SagaStepStatus {
  PENDING
  COMPLETED
  FAILED
  SKIPPED
  REVERSING
  REVERSED
}

model Saga {
  id            String    @id @default(cuid())
  sagaType      String
  transactionId String    @unique
  walletId      String
  userId        String?
  status        SagaStatus @default(PENDING)
  currentStep   Int       @default(0)
  totalSteps    Int       @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  failedAt      DateTime?
  reversedAt    DateTime?
  errorMessage  String?
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  steps         SagaStep[]
  
  @@index([transactionId])
  @@index([walletId])
  @@index([status])
  @@index([createdAt])
  @@index([sagaType])
}

model SagaStep {
  id            String    @id @default(cuid())
  sagaId        String
  stepNumber    Int
  stepType      String
  action        String
  status        SagaStepStatus @default(PENDING)
  result        Json?
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?
  
  reversalSagaId String?
  isReversal    Boolean  @default(false)
  
  saga          Saga     @relation(fields: [sagaId], references: [id], onDelete: Cascade)
  
  @@id([sagaId, stepNumber])
  @@index([sagaId])
  @@index([status])
  @@index([stepType])
  @@index([createdAt])
}

model SagaReversal {
  id            String    @id @default(cuid())
  originalSagaId String    @unique
  reversalSagaId String?
  status        SagaStatus @default(RUNNING)
  reason        String?
  initiatedBy   String?
  initiatedAt   DateTime  @default(now())
  completedAt   DateTime?
  stepsReversed Int       @default(0)
  totalSteps    Int       @default(0)
  errorMessage  String?
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  originalSaga  Saga     @relation(fields: [originalSagaId], references: [id])
  
  @@index([originalSagaId])
  @@index([reversalSagaId])
  @@index([status])
  @@index([initiatedAt])
}
