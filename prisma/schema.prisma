// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// BATCH 1: Ledger Foundation
// ============================================

enum EntryType {
  DEBIT
  CREDIT
}

model LedgerEntry {
  id                     String    @id @default(cuid())
  transactionId          String
  walletId               String
  userId                 String
  entryType              EntryType
  accountCode            String
  amountCents            BigInt
  currency               String    @default("ZAR")
  description            String?
  reference              String?
  counterpartyWalletId   String?
  counterpartyAccountCode String?
  metadata               Json?
  createdAt              DateTime  @default(now())

  @@id([transactionId, entryType, walletId])
  @@index([walletId])
  @@index([transactionId])
  @@index([createdAt])
  @@index([entryType])
}

// ============================================
// BATCH 3: QR Payment Idempotency
// ============================================

enum QrPaymentStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

model QrPayment {
  id            String    @id @default(cuid())
  qrCodeId      String    @unique
  transactionId String    @unique
  walletId      String
  amountCents  BigInt
  currency     String    @default("ZAR")
  status        QrPaymentStatus @default(PENDING)
  reference     String?
  metadata      Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  expiresAt    DateTime
  
  @@index([qrCodeId])
  @@index([transactionId])
  @@index([walletId])
  @@index([status])
  @@index([expiresAt])
}

// ============================================
// BATCH 4: Fee Accounting Consistency
// ============================================

enum FeeType {
  TRANSACTION_FEE
  WITHDRAWAL_FEE
  DEPOSIT_FEE
  SETTLEMENT_FEE
  PLATFORM_FEE
  AGENT_COMMISSION
  SERVICE_FEE
  FX_FEE
}

enum FeeStatus {
  PENDING
  COMPLETED
  REVERSED
  REFUNDED
}

model Fee {
  id            String    @id @default(cuid())
  transactionId String
  walletId      String
  userId        String?
  feeType       FeeType
  amountCents  BigInt
  currency     String    @default("ZAR")
  status        FeeStatus @default(PENDING)
  description   String?
  reference     String?
  debitEntryId  String?
  creditEntryId String?
  metadata      Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  settledAt    DateTime?
  
  @@index([transactionId])
  @@index([walletId])
  @@index([feeType])
  @@index([status])
  @@index([createdAt])
  
  debitEntry  LedgerEntry?  @relation(fields: [debitEntryId], references: [id])
  creditEntry LedgerEntry? @relation(fields: [creditEntryId], references: [id])
}

model FeeConfiguration {
  id          String   @id @default(cuid())
  feeType     FeeType  @unique
  calculationMethod String
  baseValue   BigInt
  minFeeCents BigInt   @default(0)
  maxFeeCents BigInt?
  tiers       Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([feeType])
  @@index([isActive])
}
